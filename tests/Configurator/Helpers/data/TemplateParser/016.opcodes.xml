<opcodes>
  <output_literal value="&lt;a href=&quot;"/>
  <output_xpath expr="@href"/>
  <output_literal value="&quot;"/>
  <conditional>
    <condition_when test="@title">
      <output_literal value=" title=&quot;"/>
      <output_xpath expr="@title"/>
      <output_literal value="&quot;"/>
    </condition_when>
  </conditional>
  <output_literal value="&quot;&gt;"/>
  <apply_templates/>
  <output_literal value="&lt;/a&gt;"/>
</opcodes>