<opcodes>
  <output_literal content="&lt;a href=&quot;"/>
  <output_xpath expr="@href"/>
  <output_literal content="&quot;"/>
  <conditional>
    <condition_xpath expr="@title">
      <output_literal content=" title=&quot;"/>
      <output_xpath expr="@title"/>
      <output_literal content="&quot;"/>
    </condition_xpath>
  </conditional>
  <output_literal content="&quot;&gt;"/>
  <apply_templates/>
  <output_literal content="&lt;/a&gt;"/>
</opcodes>