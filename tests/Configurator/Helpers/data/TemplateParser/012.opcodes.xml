<opcodes>
  <buffer_literal id="0" value="&lt;blockquote"/>
  <conditional>
    <condition_when test="not(@author)">
      <buffer_literal id="0" value=" class=&quot;uncited&quot;"/>
    </condition_when>
  </conditional>
  <buffer_literal id="0" value="&gt;&lt;div&gt;"/>
  <conditional>
    <condition_when test="@author">
      <buffer_literal id="0" value="&lt;cite&gt;"/>
      <buffer_xpath id="0" select="@author"/>
      <buffer_literal id="0" value=" wrote:&lt;/cite&gt;"/>
    </condition_when>
  </conditional>
  <apply_templates/>
  <buffer_literal id="0" value="&lt;/div&gt;&lt;/blockquote&gt;"/>
</opcodes>