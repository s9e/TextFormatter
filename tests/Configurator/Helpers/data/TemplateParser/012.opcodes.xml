<opcodes>
  <output_literal value="&lt;blockquote"/>
  <conditional>
    <condition_when test="not(@author)">
      <output_literal value=" class=&quot;uncited&quot;"/>
    </condition_when>
  </conditional>
  <output_literal value="&gt;&lt;div&gt;"/>
  <conditional>
    <condition_when test="@author">
      <output_literal value="&lt;cite&gt;"/>
      <output_xpath expr="@author"/>
      <output_literal value=" wrote:&lt;/cite&gt;"/>
    </condition_when>
  </conditional>
  <apply_templates/>
  <output_literal value="&lt;/div&gt;&lt;/blockquote&gt;"/>
</opcodes>